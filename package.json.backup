{
    "name":  "flux",
    "version":  "1.2.3",
    "version-iteration":  12,
    "main":  "index.ts",
    "scripts":  {
                    "start":  "expo start --scheme netflixpro",
                    "start:dev":  "APP_VARIANT=development expo start --scheme netflixpro-dev",
                    "android":  "cd android \u0026\u0026 ./gradlew clean \u0026\u0026 cd .. \u0026\u0026 APP_VARIANT=development expo run:android -d",
                    "build:watch":  "tsc --noEmit --watch",
                    "web":  "expo start --web",
                    "build":  "tsc --noEmit \u0026\u0026 expo export",
                    "type-check":  "tsc --noEmit",
                    "lint":  "eslint . --ext .ts,.tsx --fix",
                    "lint:fix":  "eslint . --ext .ts,.tsx --fix",
                    "test":  "jest",
                    "test:watch":  "jest --watch",
                    "test:coverage":  "jest --coverage",
                    "format":  "prettier --write .",
                    "postinstall":  "echo \u0027Postinstall skipped for CI\u0027 || true"
                },
    "dependencies":  {
                         "@expo/vector-icons":  "^15.1.1",
                         "@react-native-async-storage/async-storage":  "2.2.0",
                         "@react-native-community/netinfo":  "11.5.2",
                         "@react-native-community/slider":  "5.1.2",
                         "@react-navigation/bottom-tabs":  "^7.3.10",
                         "@react-navigation/native":  "^7.1.6",
                         "@react-navigation/stack":  "^7.2.10",
                         "axios":  "^1.12.2",
                         "babel-preset-expo":  "~55.0.8",
                         "cheerio":  "1.0.0-rc.12",
                         "expo":  "^55.0.8",
                         "expo-background-task":  "~55.0.10",
                         "expo-brightness":  "~55.0.9",
                         "expo-constants":  "~55.0.16",
                         "expo-dev-client":  "~55.0.18",
                         "expo-file-system":  "~55.0.11",
                         "expo-font":  "~55.0.8",
                         "expo-linear-gradient":  "~55.0.9",
                         "expo-screen-orientation":  "~55.0.9",
                         "expo-secure-store":  "~55.0.9",
                         "expo-status-bar":  "~55.0.4",
                         "expo-system-ui":  "~55.0.10",
                         "expo-task-manager":  "~55.0.10",
                         "expo-video":  "~55.0.11",
                         "ffmpeg-kit-react-native":  "^6.0.2",
                         "parse-srt":  "^1.0.0-alpha",
                         "react":  "19.2.0",
                         "react-native":  "0.83.6",
                         "react-native-draggable-flatlist":  "^4.0.3",
                         "react-native-gesture-handler":  "~2.30.0",
                         "react-native-reanimated":  "4.2.1",
                         "react-native-safe-area-context":  "~5.6.0",
                         "react-native-screens":  "~4.23.0",
                         "react-native-svg":  "15.15.3",
                         "react-native-vector-icons":  "^10.2.0",
                         "react-native-webview":  "13.16.0",
                         "react-native-worklets":  "0.7.4"
                     },
    "devDependencies":  {
                            "@babel/core":  "^7.20.0",
                            "@expo/ngrok":  "^4.1.3",
                            "@types/cheerio":  "^0.22.35",
                            "@types/react":  "^19.2.17",
                            "@types/react-native":  "^0.72.8",
                            "@types/react-native-vector-icons":  "^6.4.18",
                            "@typescript-eslint/eslint-plugin":  "^8.62.0",
                            "@typescript-eslint/parser":  "^8.62.0",
                            "baseline-browser-mapping":  "^2.9.11",
                            "eslint":  "^9.39.4",
                            "eslint-config-prettier":  "^10.1.8",
                            "eslint-plugin-prettier":  "^5.5.6",
                            "eslint-plugin-react":  "^7.37.5",
                            "eslint-plugin-react-hooks":  "^7.1.1",
                            "patch-package":  "^8.0.0",
                            "prettier":  "^3.9.1",
                            "typescript":  "^5.9.3"
                        },
    "private":  true
}
