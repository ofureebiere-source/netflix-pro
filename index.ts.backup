import { registerRootComponent } from 'expo';
import { AppRegistry, Platform } from 'react-native';

console.log('[INDEX] 🚀 Application starting...');
console.log('[INDEX] Platform:', Platform.OS);

import App from './App';

console.log('[INDEX] ✅ App imported');

registerRootComponent(App);
console.log('[INDEX] ✅ App registered');

if (Platform.OS === 'android') {
  try {
    AppRegistry.registerComponent('main', () => App);
    console.log('[INDEX] ✅ Android registration complete');
  } catch (e) {
    console.warn('[INDEX] Android registration error:', e);
  }
}
