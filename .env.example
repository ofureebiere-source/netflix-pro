# ============================================
# Netflix Pro - Expo Environment Variables
# Compatible with Expo Constants (expo-constants)
# ============================================

# ─────────────────────────────────────────────────────────────────────────────
# SUPABASE (For Comments, Search Aggregation, Analytics)
# ─────────────────────────────────────────────────────────────────────────────

# Get these from your Supabase project settings
# https://app.supabase.com/project/[your-project-id]/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY_HERE

# ─────────────────────────────────────────────────────────────────────────────
# API KEYS
# ─────────────────────────────────────────────────────────────────────────────

# TMDB API (Free - https://www.themoviedb.org/signup)
EXPO_PUBLIC_TMDB_API_KEY=YOUR_TMDB_API_KEY_HERE

# Xyra Drama API (Get from https://api.xyra.stream)
EXPO_PUBLIC_XYRA_API_KEY=YOUR_XYRA_API_KEY_HERE

# OpenSubtitles API (Free - https://www.opensubtitles.com)
EXPO_PUBLIC_OPENSUBTITLES_API_KEY=YOUR_OPENSUBTITLES_API_KEY_HERE

# SubDL API (Free - https://subdl.com)
EXPO_PUBLIC_SUBDL_API_KEY=YOUR_SUBDL_API_KEY_HERE

# ─────────────────────────────────────────────────────────────────────────────
# APP CONFIG
# ─────────────────────────────────────────────────────────────────────────────

# App Variant: development or production
EXPO_PUBLIC_APP_VARIANT=YOUR_APP_VARIANT_HERE

# App Scheme
EXPO_PUBLIC_APP_SCHEME=YOUR_APP_SCHEME_HERE

# ─────────────────────────────────────────────────────────────────────────────
# THIRD PARTY SERVICES
# ─────────────────────────────────────────────────────────────────────────────

# Consumet API (Free - https://consumet.org)
EXPO_PUBLIC_CONSUMET_BASE_URL=https://your-consumet-instance.example

# MavinEngine (NewPipe) - Local module
EXPO_PUBLIC_MAVIN_ENGINE_ENABLED=true

# ─────────────────────────────────────────────────────────────────────────────
# FEATURE FLAGS
# ─────────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_ENABLE_COMMENTS=true
EXPO_PUBLIC_ENABLE_LIVE_VIEWER_COUNTS=true
EXPO_PUBLIC_ENABLE_PRELOADER=true
EXPO_PUBLIC_ENABLE_BACKGROUND_TASKS=true
EXPO_PUBLIC_ENABLE_DEEP_LINKING=true

# ─────────────────────────────────────────────────────────────────────────────
# CACHE CONFIG (TTL in seconds)
# ─────────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_CACHE_TTL_HOME=300
EXPO_PUBLIC_CACHE_TTL_DETAILS=600
EXPO_PUBLIC_CACHE_TTL_SEARCH=300
EXPO_PUBLIC_CACHE_TTL_TRENDING=1800

# ─────────────────────────────────────────────────────────────────────────────
# DOWNLOAD CONFIG
# ─────────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_MAX_CONCURRENT_DOWNLOADS=3
EXPO_PUBLIC_AUTO_DELETE_WATCHED_DAYS=7
EXPO_PUBLIC_AUTO_DELETE_UNWATCHED_DAYS=30

# ─────────────────────────────────────────────────────────────────────────────
# PLAYER CONFIG
# ─────────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_DEFAULT_PLAYER_QUALITY=YOUR_DEFAULT_PLAYER_QUALITY_HERE
EXPO_PUBLIC_DEFAULT_SUBTITLE_LANGUAGE=YOUR_DEFAULT_SUBTITLE_LANGUAGE_HERE
EXPO_PUBLIC_DEFAULT_SUBTITLE_SIZE=100

# ─────────────────────────────────────────────────────────────────────────────
# BUILD CONFIG
# ─────────────────────────────────────────────────────────────────────────────

EXPO_PUBLIC_BUILD_DATE=YOUR_BUILD_DATE_HERE
EXPO_PUBLIC_BUILD_VERSION=1.0.0

# ============================================
# END OF CONFIG
# ============================================
