# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real keys.
#
# Expo automatically inlines any var prefixed EXPO_PUBLIC_ from `.env`
# into the JS bundle at build time — no extra config needed. That also
# means these are NOT secret once the app is built: don't put anything
# here that needs to stay server-side only.

# ── TMDB (required) ──────────────────────────────────────────────────────
# Metadata (search, discover, details, trending) is entirely TMDB-backed.
# Get a free key at https://www.themoviedb.org/settings/api
EXPO_PUBLIC_TMDB_API_KEY=

# ── Licensed video backend (required for playback/downloads) ────────────
# The Net-web backend (ofureebiere-source/Net-web) — this project's own HTTP
# service, which wraps the same scrapers the terminal UI uses.
# See src/services/licensedPlayback/LicensedPlaybackService.ts for the full
# request/response contract.
#
# Leave this unset and the app falls back to DEFAULT_BASE_URL in
# LicensedPlaybackService.ts, which points at the deployed Net-web service.
# Set it explicitly to override — e.g. to run against a local server.
EXPO_PUBLIC_LICENSED_BACKEND_URL=
# Optional — the deployed Net-web service does not require a key today.
# Sent as `Authorization: Bearer <this value>` when set.
EXPO_PUBLIC_LICENSED_BACKEND_API_KEY=

# ── Trakt (optional) ──────────────────────────────────────────────────────
# Powers watch-history sync / recommendations via Trakt.tv. App works
# without this — Trakt-backed features just won't be available.
# Register an app at https://trakt.tv/oauth/applications
EXPO_PUBLIC_TRAKT_CLIENT_ID=
